# --- Core Server ---
PORT=3000
AGENT_MODEL_ID=claude-3.5-sonnet

# --- LiteLLM Proxy Gateway ---
LITELLM_BASE_URL=http://localhost:4000/v1
LITELLM_API_KEY=sk-local-dev-key
EMBEDDING_MODEL_ID=text-embedding-default

# --- AWS Credentials (consumed by LiteLLM Proxy for Bedrock models) ---
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# --- PostgreSQL + pgvector ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
DATABASE_URL=

# --- MCP Server ---
# Example: http://localhost:8080/sse
MCP_SERVER_URL=

# --- Optional Search Tools ---
# Get a key at https://tavily.com (optional; enables web_search tool when set)
TAVILY_API_KEY=

# --- Agent Effort & Context Knobs (Optional) ---
# Max output tokens per model call
AGENT_MAX_TOKENS=4096
# >0 turns on extended thinking reasoning budget (requires thinking-capable model)
AGENT_THINKING_BUDGET=0
# Cap tool-use cycles per turn; empty = let the model decide
AGENT_MAX_TURNS=
# Recent messages kept in the context window
AGENT_CONVERSATION_WINDOW=40
# Max characters of any single tool result allowed into context
AGENT_TOOL_OUTPUT_CAP=20000
# Max characters per injected memory entry
AGENT_MEMORY_ENTRY_CAP=500
