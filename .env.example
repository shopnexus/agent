# --- Core (always required) ---
AWS_REGION=ap-southeast-1
# ap-southeast-1 typically needs an APAC cross-region inference profile:
AGENT_MODEL_ID=apac.anthropic.claude-3-5-sonnet-20241022-v2:0
PORT=3000

# --- Effort knobs (optional; defaults keep behaviour unchanged) ---
# Max output tokens per model call.
AGENT_MAX_TOKENS=4096
# >0 turns on Claude extended thinking with this reasoning budget (tokens).
# maxTokens is auto-raised above the budget; requires a thinking-capable model.
AGENT_THINKING_BUDGET=0
# Cap tool-use cycles per turn; empty = let the model decide (unbounded).
AGENT_MAX_TURNS=
# Max chars of any single tool result allowed into context; overflow spills to a
# temp file the agent pages through via the read_output tool.
AGENT_TOOL_OUTPUT_CAP=20000
# Max chars per injected memory entry (keeps the <memory> block tight).
AGENT_MEMORY_ENTRY_CAP=500
# Recent messages kept in the loop; older ones drop so tool-heavy turns don't
# grow context unbounded.
AGENT_CONVERSATION_WINDOW=40
# AWS creds via the standard chain (env, ~/.aws/credentials, role, ...).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Memory (REQUIRED; npm run setup:memory) — app won't boot without it ---
AGENTCORE_MEMORY_ID=

# --- Code Interpreter sandbox ---
# Managed default; override only if you created a custom interpreter.
AGENTCORE_CODE_INTERPRETER_ID=aws.codeinterpreter.v1

# --- Browser (cloud browser for the `browse` tool) ---
AGENTCORE_BROWSER_ID=aws.browser.v1

# --- Identity / OAuth (npm run setup:identity) ---
AGENTCORE_WORKLOAD_NAME=
AGENTCORE_OAUTH_PROVIDER_NAME=
OAUTH_SCOPES=
# IdP details consumed by the setup scripts (not read at runtime):
# OAUTH_DISCOVERY_URL=https://<idp>/.well-known/openid-configuration
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=

# --- Gateway / MCP (npm run setup:gateway) ---
AGENTCORE_GATEWAY_URL=

# --- Web search (optional; enables the web_search tool when set) ---
# Get a key at https://tavily.com
TAVILY_API_KEY=
# IAM role the Gateway assumes (consumed by setup:gateway):
# AGENTCORE_GATEWAY_ROLE_ARN=
