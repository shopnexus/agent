# --- Core Server ---
PORT=3000
# LiteLLM alias every turn uses; must exist in the LiteLLM config.
AGENT_MODEL_ID=console-agent

# --- Console trust (shared with server2; never commit values) ---
# server2 sends it as `Authorization: Bearer …` with X-Console-Member and
# X-Console-Role. Empty refuses every request.
AGENT_SERVICE_TOKEN=
# Sent to server2's MCP on every turn, with X-Console-Member.
AGENT_MCP_TOKEN=

# --- MCP server: server2's /mcp (Streamable HTTP) ---
# Example: http://server:8090/mcp
MCP_SERVER_URL=

# --- LiteLLM Proxy Gateway ---
LITELLM_BASE_URL=http://localhost:4000/v1
LITELLM_API_KEY=
EMBEDDING_MODEL_ID=bge-m3
# Read by docker/litellm-config.yaml for local routes.
GEMINI_API_KEY=
EMBEDDING_API_KEY=

# --- PostgreSQL + pgvector ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_DB=shopnexus_agent
POSTGRES_PORT=5432
# Prisma CLI only (validate, migrate); the service builds its URL from POSTGRES_*.
DATABASE_URL=

# --- Turn knobs (optional) ---
# Deadline per turn in ms; a turn past it ends TIMED_OUT.
AGENT_TURN_DEADLINE_MS=60000
# How often the stuck-turn sweep runs, in ms.
AGENT_SWEEP_INTERVAL_MS=60000
# Max output tokens per model call
AGENT_MAX_TOKENS=4096
# >0 turns on extended thinking reasoning budget (requires thinking-capable model)
AGENT_THINKING_BUDGET=0
# Cap tool-use cycles per turn; empty = let the model decide
AGENT_MAX_TURNS=
# Recent messages kept in the context window
AGENT_CONVERSATION_WINDOW=40
# Max characters of any single tool result allowed into context
AGENT_TOOL_OUTPUT_CAP=20000
# Whole-turn history limits (current input is appended once)
AGENT_HISTORY_TURNS=20
AGENT_HISTORY_CHARS=60000

# --- `npm run chat` only: the console member the CLI asks as ---
CLI_MEMBER_ID=
CLI_MEMBER_ROLE=moderator

# Opt-in only, disposable database already provisioned with the schema
# TEST_DATABASE_URL=postgresql://...
