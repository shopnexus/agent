# --- Core Server ---
PORT=3000
# LiteLLM alias a run uses when agent_config gives none; must exist in LiteLLM.
AGENT_MODEL_ID=console-agent

# --- Service trust (shared with server; never commit values) ---
# server sends it as `Authorization: Bearer …` on POST /runs. Empty refuses every run.
AGENT_SERVICE_TOKEN=
# Sent to server's MCP (with X-Console-Member) and to its control endpoint.
AGENT_MCP_TOKEN=

# --- MCP server: server's /mcp (Streamable HTTP) ---
# Its origin also serves GET /agent/turns/{id}/control. Example: http://server:9090/mcp
MCP_SERVER_URL=

# --- LiteLLM Proxy Gateway ---
LITELLM_BASE_URL=http://localhost:4000/v1
LITELLM_API_KEY=

# --- Run knobs (optional) ---
# Deadline per run segment in ms when agent_config.limits.deadline_s is absent.
AGENT_TURN_DEADLINE_MS=60000
# Max output tokens per model call
AGENT_MAX_TOKENS=4096
# >0 turns on extended thinking reasoning budget (requires thinking-capable model)
AGENT_THINKING_BUDGET=0
# Messages of prior turns replayed, at most
AGENT_CONVERSATION_WINDOW=40
# Characters of prior turns replayed, at most
AGENT_HISTORY_CHARS=60000
# Max characters of any single tool result allowed into context
AGENT_TOOL_OUTPUT_CAP=20000

# Defaults for what agent_config.limits leaves out
AGENT_CONTEXT_WINDOW=128000
AGENT_TOOL_TIMEOUT_MS=20000
AGENT_TOOL_ATTEMPTS=3
AGENT_MAX_MODEL_CALLS=40

# --- `npm run chat` only: the console member the CLI asks as ---
CLI_MEMBER_ID=
CLI_MEMBER_ROLE=moderator
