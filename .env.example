# --- Core Server ---
PORT=3000
AGENT_MODEL_ID=gemma-4-31b-free
# Separate OpenRouter credentials: keep OPEN_ROUTER_API_KEY for BGE-M3 embeddings.
OPEN_ROUTER_API_KEY=your_openrouter_api_key_for_embeddings
FALL_BACK_OPEN_ROUTER_API_KEY=your_openrouter_api_key_for_agent

# --- LiteLLM Proxy Gateway ---
LITELLM_BASE_URL=http://localhost:4000/v1
LITELLM_API_KEY=sk-local-dev-key
EMBEDDING_MODEL_ID=text-embedding-default

# --- PostgreSQL + pgvector ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=shopnexus_agent
POSTGRES_PORT=5432
DATABASE_URL=

# --- MCP Server ---
# Example: http://localhost:8080/sse
MCP_SERVER_URL=

# --- Agent Effort & Context Knobs (Optional) ---
# Max output tokens per model call
AGENT_MAX_TOKENS=4096
# >0 turns on extended thinking reasoning budget (requires thinking-capable model)
AGENT_THINKING_BUDGET=0
# Cap tool-use cycles per turn; empty = let the model decide
AGENT_MAX_TURNS=
# Recent messages kept in the context window
AGENT_CONVERSATION_WINDOW=40
# Max characters of any single tool result allowed into context
AGENT_TOOL_OUTPUT_CAP=20000
# Max characters per personal statement
AGENT_MEMORY_ENTRY_CAP=500
# Whole-turn history limits (current input is appended once)
AGENT_HISTORY_TURNS=20
AGENT_HISTORY_CHARS=60000
# Actor-scoped retrieval content budget and extracted-text chunk length
RETRIEVAL_CONTEXT_CHARS=12000
DOCUMENT_CHUNK_CHARS=2000
# Opt-in only, disposable database already provisioned with the new schema
# TEST_DATABASE_URL=postgresql://...
