generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  extensions = [vector, pg_trgm]
}

enum ConversationStatus {
  active
  archived
  closed
  @@map("conversation_status")
}
enum ConversationSubjectKind {
  ticket
  report_case
  account
  @@map("conversation_subject_kind")
}
enum TurnStatus {
  RUNNING
  PAUSED
  AWAITING_INPUT
  AWAITING_APPROVAL
  SUCCEEDED
  FAILED
  CANCELLED
  TIMED_OUT
  @@map("turn_status")
}
enum MessageRole {
  USER
  ASSISTANT
  @@map("message_role")
}
enum MessageBlockKind {
  THINKING
  TEXT
  TOOL_USE
  TOOL_RESULT
  CLARIFICATION_REQUEST
  APPROVAL_REQUEST
  @@map("message_block_kind")
}
enum ToolCallStatus {
  pending
  running
  success
  failed
  cancelled
  @@map("tool_call_status")
}
enum RetrievalOrigin {
  STATEMENT
  EXCERPT
  @@map("retrieval_origin")
}
enum RetrievalKind {
  FACT
  PREFERENCE
  SUMMARY
  @@map("retrieval_kind")
}

model Actor {
  id String @id @db.VarChar(64)
  locale String @default("en-US") @db.VarChar(8)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz
  conversations Conversation[]
  turns Turn[]
  retrieval Retrieval[]
  @@map("actors")
}
model Conversation {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId String @map("actor_id") @db.VarChar(64)
  subjectKind ConversationSubjectKind? @map("subject_kind")
  subjectId String? @map("subject_id") @db.Uuid
  title String?
  status ConversationStatus @default(active)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz
  lastActivityAt DateTime @default(now()) @map("last_activity_at") @db.Timestamptz
  actor Actor @relation(fields: [actorId], references: [id], onDelete: Cascade)
  turns Turn[]
  documents Document[]
  @@index([actorId, lastActivityAt(sort: Desc), id], map: "idx_conversations_actor")
  // Partial unique index (subject_kind, subject_id) WHERE subject_kind IS NOT NULL lives in SQL.
  @@map("conversations")
}
model Turn {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String @map("conversation_id") @db.Uuid
  memberId String @map("member_id") @db.VarChar(64)
  ordinal Int
  status TurnStatus @default(RUNNING)
  modelId String? @map("model_id") @db.VarChar(128)
  stopReason String? @map("stop_reason") @db.VarChar(32)
  inputTokens BigInt @default(0) @map("input_tokens")
  outputTokens BigInt @default(0) @map("output_tokens")
  latencyMs BigInt? @map("latency_ms")
  startedAt DateTime @default(now()) @map("started_at") @db.Timestamptz
  finishedAt DateTime? @map("finished_at") @db.Timestamptz
  errorCode String? @map("error_code") @db.VarChar(128)
  errorMessage String? @map("error_message")
  agentId String? @map("agent_id") @db.VarChar(64)
  agentName String? @map("agent_name")
  costUsd Decimal @default(0) @map("cost_usd") @db.Decimal(12, 6)
  firstTokenMs Int? @map("first_token_ms")
  provider String? @map("provider") @db.VarChar(128)
  runStartedAt DateTime @default(now()) @map("run_started_at") @db.Timestamptz
  deadlineMs Int @default(60000) @map("deadline_ms")
  eventSeq BigInt @default(0) @map("event_seq")
  state Json?
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  member Actor @relation(fields: [memberId], references: [id])
  messages Message[]
  toolCalls ToolCall[]
  retrieval Retrieval[]
  events TurnEvent[]
  documents Document[]
  @@unique([conversationId, ordinal], map: "turns_conversation_ordinal_unique")
  @@index([startedAt], map: "idx_turns_started")
  @@unique([id, conversationId], map: "turns_id_conversation_unique")
  // Partial index idx_turns_running (run_started_at) WHERE status = 'RUNNING' lives in SQL.
  @@map("turns")
}
model Message {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  turnId String @map("turn_id") @db.Uuid
  conversationId String @map("conversation_id") @db.Uuid
  role MessageRole
  ordinal Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  turn Turn @relation(fields: [turnId, conversationId], references: [id, conversationId], onDelete: Cascade)
  blocks MessageBlock[]
  @@unique([turnId, ordinal], map: "messages_turn_ordinal_unique")
  @@index([conversationId, createdAt, id], map: "idx_messages_conversation")
  @@map("messages")
}
model MessageBlock {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  messageId String @map("message_id") @db.Uuid
  ordinal Int
  kind MessageBlockKind
  isTerminal Boolean @default(false) @map("is_terminal")
  text String?
  toolUseId String? @map("tool_use_id") @db.VarChar(64)
  toolName String? @map("tool_name") @db.VarChar(128)
  payload Json?
  eventSeq BigInt @map("event_seq")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  @@unique([messageId, ordinal], map: "message_blocks_message_ordinal_unique")
  @@unique([messageId, eventSeq], map: "message_blocks_event_unique")
  @@map("message_blocks")
}
model ToolCall {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  turnId String @map("turn_id") @db.Uuid
  toolUseId String @map("tool_use_id") @db.VarChar(64)
  toolName String @map("tool_name") @db.VarChar(128)
  toolSource String? @map("tool_source") @db.VarChar(32)
  input Json @default("{}")
  output String?
  outputSpilled Boolean @default(false) @map("output_spilled")
  status ToolCallStatus @default(success)
  latencyMs Int? @map("latency_ms")
  attempts Int @default(1)
  attemptErrors Json @default("[]") @map("attempt_errors")
  toolLabel String? @map("tool_label") @db.VarChar(200)
  timing Json?
  finishedAt DateTime? @map("finished_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  turn Turn @relation(fields: [turnId], references: [id], onDelete: Cascade)
  @@unique([turnId, toolUseId], map: "tool_calls_turn_use_unique")
  @@index([toolName, createdAt(sort: Desc)], map: "idx_tool_calls_name")
  @@index([createdAt], map: "idx_tool_calls_created")
  @@map("tool_calls")
}
model Retrieval {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId String @map("actor_id") @db.VarChar(64)
  origin RetrievalOrigin
  kind RetrievalKind?
  importance Int @default(3) @db.SmallInt
  content String
  searchText String @map("search_text")
  embedding Unsupported("vector(1024)")
  sourceTurnId String? @map("source_turn_id") @db.Uuid
  documentId String? @map("document_id") @db.Uuid
  documentTitle String? @map("document_title")
  sourceUri String? @map("source_uri")
  chunkIndex Int? @map("chunk_index")
  locator String?
  supersededAt DateTime? @map("superseded_at") @db.Timestamptz
  supersededBy String? @map("superseded_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz
  expiresAt DateTime? @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz
  actor Actor @relation(fields: [actorId], references: [id], onDelete: Cascade)
  sourceTurn Turn? @relation(fields: [sourceTurnId], references: [id], onDelete: SetNull)
  successor Retrieval? @relation("RetrievalReplacement", fields: [supersededBy], references: [id], onDelete: SetNull)
  predecessors Retrieval[] @relation("RetrievalReplacement")
  @@index([actorId], map: "idx_retrieval_actor")
  @@map("retrieval")
}
model TurnEvent {
  turnId String @map("turn_id") @db.Uuid
  seq BigInt
  type String @db.VarChar(48)
  body Json @default("{}")
  at DateTime @default(now()) @db.Timestamptz
  turn Turn @relation(fields: [turnId], references: [id], onDelete: Cascade)
  @@id([turnId, seq])
  @@index([type, at], map: "idx_turn_events_type_at")
  @@map("turn_events")
}
model Document {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String @map("conversation_id") @db.Uuid
  turnId String? @map("turn_id") @db.Uuid
  title String
  latestVersion Int @default(1) @map("latest_version")
  createdBy String @map("created_by") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  turn Turn? @relation(fields: [turnId], references: [id], onDelete: SetNull)
  versions DocumentVersion[]
  @@index([conversationId, updatedAt(sort: Desc)], map: "idx_documents_conversation")
  @@map("documents")
}
model DocumentVersion {
  documentId String @map("document_id") @db.Uuid
  version Int
  title String
  sections Json
  turnId String? @map("turn_id") @db.Uuid
  createdBy String @map("created_by") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  @@id([documentId, version])
  @@map("document_versions")
}
model Skill {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdBy String @map("created_by") @db.VarChar(64)
  name String
  slug String @unique(map: "skills_slug_unique") @db.VarChar(64)
  description String @default("")
  prompt String
  variables Json @default("[]")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz
  @@map("skills")
}
